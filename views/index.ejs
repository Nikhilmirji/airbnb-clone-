<% layout("boilerplate.ejs")%>

    <body>
        <!-- <h2>all listing</h2> -->
        <!-- <form action="/listing/new" method="get">
        <button>get listing</button>
    </form> -->
        
        <h3>all listings</h3>

        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
            <% for (listing of alllisting) { %>
                <a href="/listing/<%=listing._id%>" class="listinglink">
                    <div class="col mb-4 "> <!-- Added this wrapper -->
                        <div class="listing-card card" style="width: 100%;">
                            <!-- Changed to width: 100% for proper responsive scaling -->
                            <img src="<%= listing.image.url %>" class="card-img-top" alt="getger" style="height: 20rem;">



                            <div class="card-img-overlay">
                                <h5 class="card-title"></h5>
                                <p class="card-text">
                                </p>
                                <p class="card-text"><small></small></p>
                            </div>




                            <div class="card-body">
                                <p class="card-text">
                                    <b>
                                        <%= listing.title %>
                                    </b><br>
                                    <% if (listing.price !=null) { %>
                                        &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
                                            <% } else { %>
                                                <span class="text-danger">No price set</span>
                                                <% } %>

                                </p>
                            </div>
                        </div>
                    </div>
                </a>
                <% } %>
        </div>


    </body>