<% layout("boilerplate.ejs")%>

    <body>
        <div class="row">
            <div class="col-8 offset-2">
                <br>
                <h2>enter the details of the listing</h2>

                <form action="/listing" method="post" novalidate class="needs-validation"  enctype="multipart/form-data">

                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" name="listing[title]" placeholder="enter  title" class="form-control" required>
                        <div class="valid-feedback">
                            Title looks good !!
                        </div>
                    </div>
                    <br>
                    <br>

                    <div class="mb-3">
                        <label for="description" class="form-label">description </label>
                        <textarea name="listing[description]" placeholder="enter  description"
                            class="form-control" required></textarea>
                            <div class="valid-feedback">
                                description looks good !!

                            </div>
                    </div>
                    <br>
                    <br>

                

                    <!-- <div class="mb-3">
                        <label for="image" class="form-label">Image link </label>
                        <input type="text" name="listing[image]" placeholder="enter  image  link" class="form-control" >
                        <div class="valid-feedback">
                            Image link looks good !!

                        </div>
                    </div> -->
                    <div class="mb-3">
                        <label for="image" class="form-label">Image link </label>
                        <input type="file" name="image" placeholder="Upload image file" class="form-control" >
                        required
                        <div class="valid-feedback">
                            Image  looks good !!

                        </div>
                    </div>
                    <br>
                    <br>

                    <div class="row">
                    <div class="mb-3 col-4">
                        <label for="price" class="form-label">price </label>
                        <input type="" name="listing[price]" placeholder="enter  price" class="form-control"required >
                        <div class="valid-feedback">
                            price entered!

                        </div>
                    </div>
                    <br>
                    <br>

                    

                    <div class="mb-3 col-8">
                        <label for="country" class="form-label">country </label>
                        <input type="text" name="listing[country]" placeholder="enter  country" class="form-control" required>
                        <div class="valid-feedback">

                        </div>
                    </div>

                    </div>
                    <br>
                    <br>

                    <div class="mb-3">
                        <label for="location" class="form-label">location </label>
                        <input type="text" name="listing[location]" placeholder="enter  location" class="form-control"required >
                        <div class="valid-feedback">

                        </div>
                    </div>
                    <br>
                    <br>

                    <button class="btn btn-dark  addbtn"> Add</button>
                    <br>
                    <br>
                </form>
            </div>
        </div>
        <!-- <script src="/public/form.js"></script> -->

    </body>